# Copy to .env and fill in. .env* is gitignored except this example file.
# NEVER put a real key in this file — it is the one env file that is committed.

# ---------- Server-side secrets (never reach the browser) ----------

# Gemini, used by server.ts for bill scanning, quick-add and the agent.
# Get one at aistudio.google.com. Without it the app still runs: paste a
# personal key in Settings, or use the on-device parser and manual entry.
GEMINI_API_KEY=""

# Supabase service role key — bypasses row level security, so server only.
# Supabase dashboard > Project settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary, for signing bill-photo uploads server-side. Dashboard shows all
# three. The frontend only ever sees the cloud name.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Comma-separated emails allowed to create an account while signups are closed.
# Leave empty to allow anyone with a Google account.
ALLOWED_EMAILS=""

# Monthly Gemini calls funded per account before a personal key is required.
AI_MONTHLY_CAP="50"

# Port for the companion server (default 3001).
PORT="3001"

# ---------- Public, safe to ship in the bundle ----------

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_CLOUDINARY_CLOUD_NAME=""
